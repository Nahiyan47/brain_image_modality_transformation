# Define Generator and Discriminator
class Generator(nn.Module):
    def __init__(self):
        super(Generator, self).__init__()
        # Example architecture (feel free to modify)
        self.model = nn.Sequential(
            nn.Conv2d(1, 64, kernel_size=7, padding=3),
            nn.ReLU(),
            nn.Conv2d(64, 64, kernel_size=7, padding=3),
            nn.ReLU(),
            nn.Conv2d(64, 1, kernel_size=7, padding=3)  # No Sigmoid activation, for pixel-wise loss
        )

    def forward(self, x):
        return self.model(x)

class Discriminator(nn.Module):
    def __init__(self):
        super(Discriminator, self).__init__()
        # Example architecture (feel free to modify)
        self.model = nn.Sequential(
            nn.Conv2d(1, 64, kernel_size=7, padding=3),
            nn.ReLU(),
            nn.Conv2d(64, 64, kernel_size=7, padding=3),
            nn.ReLU(),
            nn.Conv2d(64, 1, kernel_size=7, padding=3),
            nn.Sigmoid()
        )

    def forward(self, x):
        return self.model(x)

# Initialize models
G_flair_to_t2w = Generator().to(device)
G_t2w_to_flair = Generator().to(device)
D = Discriminator().to(device)

# Loss functions
adversarial_criterion = nn.BCELoss()
pixelwise_criterion = nn.L1Loss()  # Pixel-wise loss (L1 Loss)
lambda_cycle = 10  # Weight for cycle consistency loss

# Optimizers
optimizer_G = optim.Adam(
    list(G_flair_to_t2w.parameters()) + list(G_t2w_to_flair.parameters()), lr=0.0002
)
optimizer_D = optim.Adam(D.parameters(), lr=0.0002)

# Training loop
