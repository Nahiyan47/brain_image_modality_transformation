# Custom Dataset Class with Random Shuffling of Slices
class BrainTumorDataset(data.Dataset):
    def __init__(self, root_dir):
        self.root_dir = root_dir
        self.file_names = sorted(os.listdir(self.root_dir))
        self.slice_info = []  # List to hold (volume_idx, slice_idx) pairs

        # Build a list of all slices across all volumes
        for volume_idx, file_name in enumerate(self.file_names):
            file_path = os.path.join(self.root_dir, file_name)
            image_data = nib.load(file_path).get_fdata()
            num_slices = image_data.shape[2]  # Assuming slices are along the third dimension
            for slice_idx in range(num_slices):
                self.slice_info.append((volume_idx, slice_idx))

        # Shuffle the data to avoid consecutive slices
        np.random.shuffle(self.slice_info)

    def __len__(self):
        return len(self.slice_info)

    def __getitem__(self, idx):
        volume_idx, slice_idx = self.slice_info[idx]
        file_path = os.path.join(self.root_dir, self.file_names[volume_idx])
        image_data = nib.load(file_path).get_fdata()

        # Load FLAIR and T2w modalities (assuming they are at index 0 and 3 respectively)
        flair_slice = torch.tensor(image_data[:, :, slice_idx, 0], dtype=torch.float32)
        t2w_slice = torch.tensor(image_data[:, :, slice_idx, 3], dtype=torch.float32)

        # Normalize the slices to range [0, 1]
        flair_slice = (flair_slice - flair_slice.min()) / (flair_slice.max() - flair_slice.min() + 1e-8)
        t2w_slice = (t2w_slice - t2w_slice.min()) / (t2w_slice.max() - t2w_slice.min() + 1e-8)

        return flair_slice.unsqueeze(0), t2w_slice.unsqueeze(0)  # Shape: (1, H, W)

