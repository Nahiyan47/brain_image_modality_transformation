# Function to display generated images
def show_generated_images(flair, fake_t2w, recovered_flair):
    # Convert tensors to numpy for visualization
    flair_img = flair.squeeze().cpu().detach().numpy()
    fake_t2w_img = fake_t2w.squeeze().cpu().detach().numpy()
    recovered_flair_img = recovered_flair.squeeze().cpu().detach().numpy()
    
    # Plotting
    plt.figure(figsize=(12, 6))
    plt.subplot(1, 3, 1)
    plt.title("FLAIR")
    plt.imshow(flair_img, cmap='gray')
    plt.axis('off')
    
    plt.subplot(1, 3, 2)
    plt.title("Fake T2w")
    plt.imshow(fake_t2w_img, cmap='gray')
    plt.axis('off')
    
    plt.subplot(1, 3, 3)
    plt.title("Recovered FLAIR")
    plt.imshow(recovered_flair_img, cmap='gray')
    plt.axis('off')
    
    plt.show()

# Training
for epoch in range(num_epochs):
    G_flair_to_t2w.train()
    G_t2w_to_flair.train()
    D.train()
    
    for i, (flair, t2w) in enumerate(train_loader):
        flair = flair.to(device)
        t2w = t2w.to(device)

        # ---------------------
        #  Train Discriminator
        # ---------------------
        optimizer_D.zero_grad()

        # Real images
        real_output = D(t2w)
        real_labels = torch.ones_like(real_output).to(device)
        d_real_loss = adversarial_criterion(real_output, real_labels)

        # Fake images
        fake_t2w = G_flair_to_t2w(flair)
        fake_output = D(fake_t2w.detach())
        fake_labels = torch.zeros_like(fake_output).to(device)
        d_fake_loss = adversarial_criterion(fake_output, fake_labels)

        # Total Discriminator loss
        d_loss = (d_real_loss + d_fake_loss) / 2
        d_loss.backward()
        optimizer_D.step()

        # -----------------
        #  Train Generators
        # -----------------
        optimizer_G.zero_grad()

        # Adversarial loss
        fake_output = D(fake_t2w)
        g_adv_loss = adversarial_criterion(fake_output, real_labels)

        # Cycle consistency loss
        recovered_flair = G_t2w_to_flair(fake_t2w)
        cycle_loss = pixelwise_criterion(recovered_flair, flair)

        # Total Generator loss
        g_loss = g_adv_loss + lambda_cycle * cycle_loss
        g_loss.backward()
        optimizer_G.step()

        if i % 100 == 0:
            print(
                f"Epoch [{epoch+1}/{num_epochs}], Step [{i}/{len(train_loader)}], "
                f"G Loss: {g_loss.item():.4f}, D Loss: {d_loss.item():.4f}"
            )
            show_generated_images(flair, fake_t2w, recovered_flair)

